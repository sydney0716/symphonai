# Copy this file to .env and fill in real values there. .env is
# gitignored; this file (.env.example) is not, and must never contain a
# real key -- see docs/symphonai-api-runtime.md.
#
# symphonai_api reads keys from the environment only (os.environ), never
# from a config or .env file directly -- nothing in this repo auto-loads
# .env yet, so export these into your shell before running
# scripts/live_test_provider.py --live, e.g.:
#   export $(grep -v '^#' .env | xargs)
# or use a tool like direnv.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
