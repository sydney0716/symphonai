# Copy this file to .env and fill in real values there. .env is
# gitignored; this file (.env.example) is not, and must never contain a
# real key.
#
# SymphonAI reads keys from the environment only, never from .env directly.
# Load them into your shell before starting it:
#   set -a; . ./.env; set +a
# or use a tool like direnv. Keys can also be added in the app under
# Settings › Models. Leave any line empty that you don't use.

# Model providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# OpenAI-compatible providers (the provider catalog)
XAI_API_KEY=
MOONSHOT_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
OLLAMA_API_KEY=

# Web search backends
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=

# Vendor cost reports for /stats. These are organization admin keys
# (Anthropic: sk-ant-admin..., OpenAI: sk-admin-..., ideally restricted to
# read-only usage). Only the host's usage code reads them; agents' shells
# never receive variables named *KEY*.
ANTHROPIC_ADMIN_KEY=
OPENAI_ADMIN_KEY=
